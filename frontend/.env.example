# ==============================================================================
# FRONTEND & BACKEND URL CONFIGURATION
# (Keep local URLs for development; update with online HTTPS URLs when deploying)
# ==============================================================================

# Backend API Base URL
# For local development: http://localhost:5000
# For online production deployment: set to your deployed backend HTTPS URL (e.g. https://api.yourdomain.com)
VITE_API_URL=http://localhost:5000
VITE_BACKEND_URL=http://localhost:5000

# Frontend Client URL
# For local development: http://localhost:5173
# For online production deployment: set to your deployed frontend HTTPS URL (e.g. https://yourdomain.com)
VITE_FRONTEND_URL=http://localhost:5173
