# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Generate a unique random value of at least 32 characters before deployment.
SESSION_SECRET=your_long_session_secret_min_32_chars_here

# Local development bootstrap only. Never use default passwords in production.
OWNER_USERNAME=constructionskks
OWNER_EMAIL=constructionskks@gmail.com
OWNER_INITIAL_PASSWORD=kks123

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kks_constructions?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kks_constructions?retryWrites=true&w=majority

# Cloudinary Media Storage (Required in production)
# Supply individual credentials or the full CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Customer Enquiry & Resend Email Notification Settings
ENQUIRY_RECEIVER_EMAIL=constructionskks@gmail.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=notifications@yourverifieddomain.com
