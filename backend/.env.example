# MongoDB Atlas Database URI
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/kks_constructions?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary Media Storage (Required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
